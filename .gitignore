# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
.vite/

# Superpowers SDD scratch workspace (git-ignored by design)
.superpowers/

# OS
.DS_Store

# ---------------------------------------------------------------------------
# LOCAL-ONLY: everything below stays on the maintainer's machine and is kept
# out of the published repository (github.com/Steinbeck-Lab/Orthonym-Web), which was
# rewritten on 2026-09-07 so none of it appears in any commit.
# ---------------------------------------------------------------------------

# backend/vendor/ holds only the downloaded CDK jar now; the engine is
# installed from GitHub (backend/requirements.txt). Old checkouts may still
# hold a vendored engine copy there, so the whole directory stays ignored.
# backend/vendor/cdk/NOTICE is the one tracked file.
backend/vendor/*
!backend/vendor/cdk/
backend/vendor/cdk/*
!backend/vendor/cdk/NOTICE

# Agent and tooling state.
.claude/
.impeccable/
.planning/
.tools/

# Working documents: session handoffs, planning notes, the design system's
# own working record, and the env reference. Useful here, noise in public.
NEXT-SESSION.md
env_txt.txt
ENGINE-PROMPT-*.md
DESIGN.md
PRODUCT.md
docs/superpowers/
docs/architecture-notes.md

# graphify knowledge-graph output: 29 MB of generated data, rebuildable
# with /graphify. The cache/ subdir makes an incremental rebuild cheap.
graphify-out/

# Stray design reference dropped in the repo root during the Bugatti/ChemAudit
# review pass. The design system it fed is recorded in DESIGN.md; the image
# itself is a source, not a deliverable.
original-*.webp

# macOS-side venv. The tracked-in-history backend/.venv is a Linux venv
# (built under /home/kohulan on the Linux host) and cannot run here; .venv-mac
# is the local equivalent.
.venv-mac/

# Playwright MCP scratch output (browser snapshots/screenshots)
.playwright-mcp/

# Stray screenshots from browser-driving agents
/*.png

# Deployment-local operational files: htpasswd, nginx snippets, compose
# overrides. Never in git -- these carry credentials and per-host addresses.
ops/
docker-compose.override.yml
