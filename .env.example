# Orthonym configuration. Copy to .env and edit.
# Precedence: these environment variables > DEPLOYMENT_PROFILE > code defaults.
#
# One exception to that sentence, and it is the only one: VITE_GITHUB_URL at
# the bottom is a BUILD arg, not a runtime setting. Everything else here is
# read when a container starts.

# Deployment profile: small | medium | large (see backend/config/*.yml).
# medium is sized for 4 cores / 16 GB.
DEPLOYMENT_PROFILE=medium

REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=2gb

# Worker children per queue. Each child holds its own 512 MB JVM, so
# 2 + 2 is about 4 GB. Cores are the tighter limit on a 4-core host;
# raise CELERY_WORKERS_BATCH to trade interactive latency for batch speed.
CELERY_WORKERS_FAST=2
CELERY_WORKERS_BATCH=2
CELERY_LOG_LEVEL=info
ORTHONYM_JVM_XMX=512m

# Requests at or below FAST_PATH_MAX_MOLECULES answer inline; above it they
# become a job with a progress bar. Nothing is silently truncated.
FAST_PATH_MAX_MOLECULES=10
FAST_PATH_TIMEOUT=30

# Bounds how long the web process waits for a batch worker to ACCEPT an
# upload parse, not how long the parse itself may take: task_track_started is
# on, so a worker with a free slot stamps STARTED in milliseconds and only a
# fully saturated batch queue uses the whole window. On timeout the parse
# falls back to the web process, exactly as it behaved before the offload --
# never worse, and better whenever a worker is free.
PARSE_TIMEOUT=30

BATCH_CHUNK_SIZE=25
# 10,000 molecules is roughly 80 minutes on 2 batch workers. Lower this
# rather than overstating how fast a job finishes.
MAX_BATCH_SIZE=10000
MAX_FILE_SIZE_MB=50
# nginx is the BINDING upload limit, not this one. frontend/nginx.conf sets
# client_max_body_size 210m in its /api/ block, and docker-compose publishes
# the backend on 127.0.0.1 only, so every real upload passes through nginx
# first. 210m covers the largest shipped profile (backend/config/large.yml,
# MAX_FILE_SIZE_MB=200) plus headroom for multipart part headers -- exactly
# 200m would make nginx reject a file this app would have accepted.
# Raising MAX_FILE_SIZE_MB above 200 without raising nginx means nginx
# rejects the upload with a bare 413 and no app-level message explaining it.
# Note this bounds the whole BODY, not one molecule: the per-molecule bound
# is inputs.MAX_MOLECULE_SMILES_LENGTH (2000 chars), which is what stops a
# single pathological SMILES from crashing a worker.

# Results are transient. Never present a job link as permanent.
JOB_RESULT_TTL_SECONDS=86400
NAME_CACHE_TTL_SECONDS=604800

RATE_LIMIT_MAX_CONCURRENT_JOBS=2
RATE_LIMIT_JOBS_PER_HOUR=20
RATE_LIMIT_FAST_PER_MINUTE=60
# /api/depict is called once per visible row in a results table, so a
# legitimate 1,000-row view is ~1,000 calls in a minute -- which the 60/min
# budget above (sized for a single OPSIN lookup) would wrongly read as abuse.
# This is a request-count throttle, NOT a cost bound: the cost bound is
# jobs_api.MAX_DEPICT_ATOMS (300), because one 2,400-atom molecule inside the
# 4,000-character limit measured 16.7 SECONDS to draw, synchronously and
# GIL-held, in the web process.
RATE_LIMIT_DEPICT_PER_MINUTE=1200
# GET /api/jobs/{id} and .../results are polled by design: a progress bar
# checking every 1-2 s is 30-60 req/min for ONE job, and a caller can have
# several open. The 60/min budget would throttle ordinary polling, so these
# get their own larger one -- still bounded, unlike having no limiter at all.
RATE_LIMIT_POLL_PER_MINUTE=300
# results.csv is the most expensive READ on the API and gets the SMALLEST
# budget for that reason. A full 10,000-row download LRANGEs 500 rows a page
# and json.loads every one of them in the web process, so sixty of those a
# minute would be ~600,000 JSON decodes against a budget priced for sixty key
# reads. A human downloading their own results does it once or twice.
RATE_LIMIT_DOWNLOAD_PER_MINUTE=10

CHUNK_SOFT_TIME_LIMIT=600
CHUNK_HARD_TIME_LIMIT=900

# Trust the proxy's client-IP headers. TRUE is correct for the shipped
# docker-compose topology, because the backend port is published on
# 127.0.0.1 only, so nginx is the sole route in and it overwrites X-Real-IP
# from $remote_addr. These two settings are a PAIR:
#   * true + a publicly published backend port = every per-IP cap is void
#     (an attacker sets X-Real-IP per request and gets unlimited buckets).
#   * false + nginx in front = the whole internet shares ONE bucket, so 2
#     concurrent jobs and 60 requests/min for all visitors combined.
# If you expose the backend directly, set this false AND accept that per-IP
# limiting no longer works as designed. Read backend/app/ratelimit.py first.
TRUST_PROXY_HEADERS=true

# --- container memory caps (2026-09-06) -------------------------------------
# Every service has one. Without them a JVM leak or a runaway job takes the
# whole host down instead of one container, and the kernel picks the victim.
#
# The worker figure is arithmetic, not a guess: each forked child holds its
# own JVM at ORTHONYM_JVM_XMX heap plus roughly as much again in non-heap
# (metaspace, code cache, the loaded jars), and the parent carries python and
# RDKit -- about 2.3 GB at the 512m x 2 defaults. RAISE IT whenever
# CELERY_WORKERS_FAST/_BATCH or ORTHONYM_JVM_XMX goes up, or the kernel kills
# a worker mid-job instead of the job failing honestly.
WORKER_MEM_LIMIT=3g
# MUST stay ABOVE REDIS_MAXMEMORY, never equal to it: maxmemory bounds the
# dataset only, while the process also holds client buffers, replication
# backlog and fragmentation on top. Equal values get redis OOM-killed by the
# kernel instead of letting its own volatile-lru eviction run, which is the
# entire point of that policy.
REDIS_MEM_LIMIT=3g
BACKEND_MEM_LIMIT=1500m
FRONTEND_MEM_LIMIT=256m

# --- frontend build arg (2026-09-06) ----------------------------------------
# The header's GitHub link, and the one setting in this file that is NOT read
# at runtime. vite substitutes import.meta.env.VITE_* into the bundle when the
# bundle is WRITTEN, so this only takes effect through a rebuild:
#
#   VITE_GITHUB_URL="https://github.com/<owner>/Orthonym-Web" \
#     docker compose up -d --build frontend
#
# Left EMPTY on purpose. github.com/Kohulan/Orthonym is a private repository
# and answers 404 to an anonymous visitor, so for one iteration the site
# shipped a dead link in the header of every route. Empty renders no link and
# no separator; set it and both return.
#
# Which URL: Orthonym's own repository, not the engine's. A "GitHub" link in a
# site header conventionally means that site's source, and the engine is
# credited in prose on /about and /terms instead. Note nothing is published
# yet -- Kohulan/Orthonym-Web, Steinbeck-Lab/Orthonym-Web and Beilstein-Institut/Orthonym-Web
# all 404 as of 2026-09-07, and this repo has no git remote configured.
#
# Two other surfaces state the same fact in prose and must be edited BY HAND
# the day this changes: frontend/src/pages/About.jsx (the Source row) and
# frontend/src/pages/Terms.jsx (the Orthonym third-party entry).
VITE_GITHUB_URL=
