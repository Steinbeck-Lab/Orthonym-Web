.venv-mac
__pycache__
*.pyc
.pytest_cache
tests
.DS_Store

# Nothing is copied from vendor/: the Dockerfile downloads and SHA-verifies
# the CDK jar and installs the engine from GitHub. A local copy must NOT enter
# the build context -- otherwise a build on the maintainer's machine could use
# on-disk files and never exercise the download path a fresh clone depends on.
vendor/
